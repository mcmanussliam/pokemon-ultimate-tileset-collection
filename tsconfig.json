{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./site/src/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "site/**/*.ts",
    "vite.config.ts",
    "site/**/*.tsx",
    "tests/**/*.ts"
  ]
}
